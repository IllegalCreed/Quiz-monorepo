generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================
// 管理员与权限模型
// ============================================

/// 管理员表
model Admin {
  id        Int         @id @default(autoincrement())
  username  String      @unique
  password  String      // bcrypt 加密
  nickname  String
  roleId    Int
  role      Role        @relation(fields: [roleId], references: [id])
  status    AdminStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, roleId])
}

/// 管理员状态枚举
enum AdminStatus {
  ACTIVE
  DISABLED
}

/// App 用户状态枚举
enum UserStatus {
  ACTIVE
  DISABLED
}

/// 角色表
model Role {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  description      String
  isSystem         Boolean  @default(false) // 系统内置角色不可删除
  menuPermissions  Json     // string[] - 菜单权限数组
  apiPermissions   Json     // string[] - API 权限数组
  admins           Admin[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isSystem])
}

// ============================================
// 题目模型（保留现有结构）
// ============================================

model Question {
  id                 Int                @id @default(autoincrement())
  stem               String             @db.VarChar(500)
  type               String             @default("single_choice") // 题目类型，预留扩展
  explanation        String?            @db.VarChar(1000) // 答题解析（1000：构建工具章节题解较详细，500 不够）
  tags               Json?              // JSON array of tags（自由辅助标签，如"面试高频"）
  deletedAt          DateTime?          // 软删除时间戳，null 表示未删除
  options            Option[]
  questionCategories QuestionCategory[] // 结构化多维度分类关联
  answerAttempts     AnswerAttempt[]    // 答题记录
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([deletedAt])
}

model Option {
  id          Int      @id @default(autoincrement())
  question    Question @relation(fields: [questionId], references: [id])
  questionId  Int
  text        String   @db.VarChar(500)
  isCorrect   Boolean  @default(false)
  description String?  @db.VarChar(500) // 选项解析说明（答题后展示）
}

// AnswerAttempt — 答题记录（仅已登录用户记录）
model AnswerAttempt {
  id              Int       @id @default(autoincrement())
  questionId      Int
  question        Question  @relation(fields: [questionId], references: [id])
  selectedOption  Int
  correct         Boolean
  elapsedMs       Int?
  userId          Int?      // 已登录用户（游客不记录，此字段始终有值）
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([questionId])
}

// ============================================
// 多面分类体系
// ============================================

/// 分类维度（如"技术方向"、"难度"、"题型"）
model CategoryGroup {
  id         Int        @id @default(autoincrement())
  name       String
  sort       Int        @default(0)
  categories Category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// 分类节点（支持树形多级，如 "前端 > 框架 > Vue"）
model Category {
  id                 Int                @id @default(autoincrement())
  name               String
  groupId            Int
  group              CategoryGroup      @relation(fields: [groupId], references: [id])
  parentId           Int?
  parent             Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]         @relation("CategoryTree")
  sort               Int                @default(0)
  isDefault          Boolean            @default(false) // 通识节点标记（不可编辑/删除/改名）
  questionCategories QuestionCategory[]
  userPreferences    UserPreference[]   // 用户偏好分类
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([groupId])
  @@index([parentId])
}

/// 题目-分类多对多关联表
model QuestionCategory {
  questionId Int
  categoryId Int
  question   Question @relation(fields: [questionId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([questionId, categoryId])
  @@index([categoryId])
}

// ============================================
// 用户模型（quiz-app 答题用户）
// ============================================

/// quiz-app 用户（游客可答题但不记录，注册后记录答题历史）
model User {
  id             Int              @id @default(autoincrement())
  username       String           @unique
  password       String           // bcrypt 加密
  nickname       String?
  email          String?          @unique
  status         UserStatus       @default(ACTIVE)
  answerAttempts AnswerAttempt[]
  preferences    UserPreference[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

/// 用户偏好分类（多对多，已登录用户才能设置）
model UserPreference {
  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

// ============================================
// 系统日志
// ============================================

/// 日志类型枚举
enum LogType {
  LOGIN        // 登录事件（成功/失败）
  API_MUTATION // 数据变更操作（POST/PATCH/PUT/DELETE）
}

/// 操作者类型枚举
enum ActorType {
  ADMIN // 管理员
  USER  // App 用户
}

/// 系统操作日志（记录所有增删改操作及登录行为）
model SystemLog {
  id         Int       @id @default(autoincrement())
  type       LogType               // 日志类型
  actorType  ActorType             // 操作者类型
  actorId    Int?                  // 操作者 ID（匿名则 null）
  actorName  String?               // 操作者名称快照（方便查询，无需 JOIN）
  action     String                // 具体动作：CREATE / UPDATE / DELETE / LOGIN
  module     String                // 业务模块：questions, admins, auth 等
  path       String                // 请求路径
  method     String                // HTTP 方法：POST / PATCH / PUT / DELETE
  params     Json?                 // 请求参数（已过滤 password 等敏感字段）
  result     Json?                 // 响应结果（截断至 2KB）
  success    Boolean               // 操作是否成功
  error      String?   @db.Text    // 错误信息（失败时记录）
  ip         String?               // 请求者 IP
  durationMs Int?                  // 请求耗时（毫秒）
  createdAt  DateTime  @default(now())

  @@index([type])
  @@index([actorId, actorType])
  @@index([createdAt])
  @@index([module])
}
