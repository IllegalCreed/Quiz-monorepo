{
  "name": "quiz-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "dotenv -e .env.development.local -- nest start --watch",
    "build": "nest build",
    "preview": "dotenv -e .env.production.local -- sh -c 'pnpm run build && node dist/src/main.js'",
    "start:dev": "dotenv -e .env.development.local -- nest start --watch",
    "start:debug": "dotenv -e .env.development.local -- nest start --debug --watch",
    "start:prod": "dotenv -e .env.production.local -- node dist/src/main.js",
    "start:test": "dotenv -e .env.test.local -- nest start",
    "prisma:generate": "prisma generate",
    "postinstall": "pnpm run prisma:generate",
    "migrate:deploy:dev": "dotenv -e .env.development.local -- prisma migrate deploy",
    "migrate:deploy:test": "dotenv -e .env.test.local -- prisma migrate deploy",
    "migrate:deploy:prod": "dotenv -e .env.production.local -- prisma migrate deploy",
    "migrate:status": "echo '=== DEV ===' && pnpm run migrate:status:dev && echo '\n=== TEST ===' && pnpm run migrate:status:test && echo '\n=== PROD ===' && pnpm run migrate:status:prod",
    "migrate:status:dev": "dotenv -e .env.development.local -- prisma migrate status",
    "migrate:status:test": "dotenv -e .env.test.local -- prisma migrate status",
    "migrate:status:prod": "dotenv -e .env.production.local -- prisma migrate status",
    "db:studio": "pnpm run db:studio:dev",
    "db:studio:dev": "dotenv -e .env.development.local -- prisma studio",
    "db:studio:test": "dotenv -e .env.test.local -- prisma studio",
    "db:studio:prod": "dotenv -e .env.production.local -- prisma studio",
    "db:create": "node -r ts-node/register scripts/create-db.ts",
    "db:seed": "pnpm run db:seed:dev",
    "db:seed:dev": "dotenv -e .env.development.local -- node -r ts-node/register scripts/seed.ts dev",
    "db:seed:test": "dotenv -e .env.test.local -- node -r ts-node/register scripts/seed.ts test",
    "db:seed:prod": "dotenv -e .env.production.local -- node -r ts-node/register scripts/seed.ts prod",
    "db:reset:test": "pnpm run db:seed:test",
    "db:rotate-passwords": "node -r ts-node/register scripts/rotate-db-passwords.ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.{ts,js}\"",
    "lint": "NODE_OPTIONS='-r ts-node/register' eslint . --ext .ts --cache",
    "lint:fix": "NODE_OPTIONS='-r ts-node/register' eslint . --ext .ts --fix --cache",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --runInBand --config ./test/jest-e2e.json",
    "type-check": "node -r ts-node/register ./scripts/type-check-backend.ts",
    "check": "pnpm run lint && pnpm run type-check && pnpm run test:unit",
    "check:all": "pnpm run lint && pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/platform-express": "^11.1.13",
    "@prisma/adapter-mariadb": "^7.3.0",
    "@prisma/client": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.13",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "mysql2": "^3.17.0",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
