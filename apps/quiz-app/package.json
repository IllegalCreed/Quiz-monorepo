{
  "name": "quiz-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "prepare": "cypress install",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --reporter dot",
    "test:unit:dev": "vitest",
    "test:e2e": "pnpm run build:test && sh ./scripts/run-e2e.sh",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 10010' http://localhost:10010 'cypress open --e2e'",
    "build-only": "vite build",
    "build:test": "vite build --mode test",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@vueuse/components": "^14.2.0",
    "@vueuse/core": "^14.2.0",
    "@vueuse/integrations": "^14.2.0",
    "@vueuse/router": "^14.2.0",
    "dayjs": "^1.11.19",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.1",
    "@quiz/ui": "workspace:*"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.434",
    "@iconify/utils": "^3.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.9.0",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-oxlint": "~1.42.0",
    "eslint-plugin-vue": "~10.7.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.42.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "start-server-and-test": "^2.1.3",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
