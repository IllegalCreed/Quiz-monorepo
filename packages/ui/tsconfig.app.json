{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    ".storybook/**/*",
    "auto-imports.d.ts",
    "components.d.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "@unocss/vite/client"],
    "declaration": true,
    "declarationDir": "dist/types",
    "composite": false,
    "rootDir": ".",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
