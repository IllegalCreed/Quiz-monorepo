{
  "name": "@quiz/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "pnpm run storybook",
    "build": "vue-tsc -b && vite build && pnpm run build:types",
    "build:types": "vue-tsc -p tsconfig.app.json --emitDeclarationOnly --declaration --declarationDir dist/types && node scripts/check-and-fix-dts.cjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 10030 --no-open",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix --cache",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,md}\"",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:types": "tsd -p tsconfig.app.json"
  },
  "peerDependencies": {
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@iconify/utils": "^3.1.0",
    "@microsoft/api-extractor": "^7.56.0",
    "@storybook/addon-a11y": "^10.2.3",
    "@storybook/addon-docs": "^10.2.3",
    "@storybook/addon-onboarding": "^10.2.3",
    "@storybook/addon-vitest": "^10.2.3",
    "@storybook/vue3-vite": "^10.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "25.2.0",
    "@unocss/vite": "^66.6.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/compiler-dom": "^3.5.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/language-core": "^3.2.4",
    "@vue/server-renderer": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "~1.42.0",
    "eslint-plugin-vue": "~10.7.0",
    "prettier": "^3.8.1",
    "rollup": "^3.29.4",
    "rollup-plugin-dts": "^6.3.0",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.2.3",
    "tsd": "^0.33.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4"
  }
}
