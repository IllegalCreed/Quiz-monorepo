{
  "name": "@quiz/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "pnpm run storybook",
    "build": "tsdown",
    "preview": "vite preview",
    "storybook": "storybook dev -p 10030 --no-open",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix --cache",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest"
  },
  "peerDependencies": {
    "@vueuse/core": "^12.0.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@iconify/json": "^2.2.435",
    "@iconify/utils": "^3.1.0",
    "@storybook/addon-a11y": "^10.2.4",
    "@storybook/addon-docs": "^10.2.4",
    "@storybook/addon-onboarding": "^10.2.4",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/vue3-vite": "^10.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "25.2.0",
    "@unocss/core": "^66.6.0",
    "@unocss/postcss": "^66.6.0",
    "@unocss/preset-attributify": "^66.6.0",
    "@unocss/preset-icons": "^66.6.0",
    "@unocss/preset-typography": "^66.6.0",
    "@unocss/preset-web-fonts": "^66.6.0",
    "@unocss/preset-wind4": "^66.6.0",
    "@unocss/transformer-directives": "^66.6.0",
    "@unocss/vite": "^66.6.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/compiler-dom": "^3.5.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/language-core": "^3.2.4",
    "@vue/server-renderer": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^12.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "~1.43.0",
    "eslint-plugin-vue": "~10.7.0",
    "magic-string": "^0.30.21",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "rolldown": "1.0.0-rc.2",
    "rollup-plugin-sass": "^1.15.3",
    "sass": "^1.97.3",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.2.4",
    "tsdown": "^0.20.1",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue": "^7.1.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "7.3.1",
    "vitest": "^4.0.18",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.4"
  }
}
