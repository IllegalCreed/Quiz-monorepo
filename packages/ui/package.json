{
  "name": "@quiz/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "pnpm run storybook",
    "build": "tsdown",
    "preview": "vite preview",
    "storybook": "storybook dev -p 10030 --no-open",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix --cache",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:dev": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.0.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@iconify/utils": "^3.1.3",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/vue3-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsdown/css": "^0.21.10",
    "@types/node": "^25.7.0",
    "@unocss/core": "^66.6.8",
    "@unocss/postcss": "^66.6.8",
    "@unocss/preset-attributify": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-web-fonts": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/vite": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.17",
    "@vue/compiler-dom": "^3.5.34",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/language-core": "^3.2.8",
    "@vue/server-renderer": "^3.5.34",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-oxlint": "^1.64.0",
    "eslint-plugin-vue": "~10.8.0",
    "magic-string": "^0.30.21",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "rolldown": "1.0.0-rc.12",
    "sass-embedded": "^1.99.0",
    "storybook": "^10.3.6",
    "tsdown": "^0.21.10",
    "typescript": "~6.0.3",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  }
}
