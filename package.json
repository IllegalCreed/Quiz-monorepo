{
  "name": "quiz-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm clean:ports && turbo run dev --parallel",
    "dev:frontend": "pnpm -C apps/quiz-app run dev",
    "dev:admin": "pnpm -C apps/quiz-admin run dev",
    "dev:backend": "pnpm -C apps/quiz-backend run dev",
    "dev:ui": "pnpm -C packages/ui run dev",
    "build": "turbo run build",
    "build:frontend": "pnpm -C apps/quiz-app run build",
    "build:admin": "pnpm -C apps/quiz-admin run build",
    "build:backend": "pnpm -C apps/quiz-backend run build",
    "build:ui": "pnpm -C packages/ui run build",
    "deploy": "bash ./scripts/deploy.sh",
    "preview": "pnpm clean:ports && turbo run preview --parallel",
    "preview:frontend": "pnpm -C apps/quiz-app run preview",
    "preview:admin": "pnpm -C apps/quiz-admin run preview",
    "preview:test": "sh ./scripts/preview-test.sh",
    "pretest": "sh ./scripts/regenerate-test-secret.sh",
    "test": "turbo run test --concurrency 1",
    "test:unit": "turbo run test:unit --concurrency 3",
    "test:unit:coverage": "turbo run test:unit:coverage --concurrency 3",
    "test:frontend": "pnpm -C apps/quiz-app run test",
    "test:admin": "pnpm -C apps/quiz-admin run test",
    "test:backend": "pnpm -C apps/quiz-backend run test",
    "test:ui": "pnpm -C packages/ui run test",
    "clean:ports": "sh ./scripts/cleanup-ports.sh",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -w -r run lint:fix",
    "type-check": "turbo run type-check",
    "check": "pnpm run lint && pnpm run type-check && pnpm run test:unit",
    "check:e2e": "pnpm run lint && pnpm run type-check && pnpm run test:unit && pnpm run test",
    "format": "prettier --write .",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.21",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12"
  }
}
