**/components.d.ts
**/.eslintrc-auto-import.json

# Turborepo 缓存
.turbo/

# Claude cache
.claude/

# Storybook
.storybook/cache/
.storybook/public/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Env / Secrets - 只忽略包含敏感信息的 .local 文件
# 团队共享的 .env.development/.env.test 等文件可以提交
.env.local
.env.*.local
# create-db local config
apps/quiz-backend/.env.create-db.local
# Cypress per-run env (contains TEST_RESET_SECRET) — should not be committed
apps/quiz-app/cypress.env.json
apps/quiz-admin/cypress.env.json


# Test artifacts
test-results/
playwright-report/
blob-report/
# Cypress 失败截图与视频（每次 E2E 运行生成，不应提交）
**/cypress/screenshots/
**/cypress/videos/
# 临时调试/审查截图（与本地脚本/对话产物相关）
.tmp-screenshots/

# Optional: 如果你用 Docker 或其他工具
Dockerfile*
docker-compose*

# MacOS 系统文件
.AppleDouble
.LSOverride
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

