#!/usr/bin/env bash

# 类型检查（快速，必要）
echo "⏳ Running type-check..."
pnpm run type-check || { echo "❌ Type-check failed"; exit 1; }

# 运行单元测试（快速，1-2 分钟）
echo "⏳ Running unit tests..."
pnpm run test:unit || { echo "❌ Unit tests failed"; exit 1; }

echo "✅ Pre-push checks passed"
echo "💡 Note: E2E tests are skipped in pre-push (run 'pnpm test' for full suite)"
